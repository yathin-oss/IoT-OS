{
  "name": "iot-os",
  "productName": "IoT-OS",
  "version": "0.1.0",
  "description": "AI-native IoT development environment: IDE, copilot, hardware simulator, device/toolchain manager, flashing and serial debugging.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "test:hw": "IOTOS_HW_TESTS=1 vitest run --project integration",
    "host": "node dist/host/host.mjs",
    "dev:browser": "node scripts/dev.mjs --browser"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "@monaco-editor/react": "^4.7.0",
    "avr8js": "^0.21.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serialport": "^13.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@serialport/binding-mock": "^10.2.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "fsevents": false,
    "protobufjs": false
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
