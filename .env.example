# Copy to your shell profile or a local .env loader of your choice. Never commit real keys.
# AI provider keys (override keys stored in Settings):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional endpoint overrides (proxies / gateways):
# IOTOS_ANTHROPIC_BASE_URL=https://your-gateway.example.com
# IOTOS_OPENAI_BASE_URL=
# IOTOS_GEMINI_BASE_URL=
# Browser host: data directory and fixed token (a random token is generated when unset):
# IOTOS_DATA_DIR=~/.iotos
# IOTOS_HOST_TOKEN=
